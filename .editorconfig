root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Keep these selectors aligned with scripts/lib/owned-code-config.cjs.
[apps/deployment-manager/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[apps/player-admin/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[apps/player-launcher/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[apps/player-auth-portal/src/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[apps/player-auth-portal/server/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[apps/player-auth-portal/scripts/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[apps/player-auth-portal/test/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[apps/local-engine/src/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[apps/local-engine/scripts/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[internals/deployment-routing/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[scripts/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[tools/repo-tooling/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[docs/examples/**/*.{js,cjs,ts,tsx,mts,css,less}]
indent_size = 4

[.prettierrc.cjs]
indent_size = 4

[.eslintrc.cjs]
indent_size = 4

[docs/**/*.md]
indent_size = 4

[apps/{deployment-manager,player-admin,player-launcher,player-auth-portal,local-engine}/**/*.md]
indent_size = 4

[README.md]
indent_size = 4

[CONTRIBUTING.md]
indent_size = 4
