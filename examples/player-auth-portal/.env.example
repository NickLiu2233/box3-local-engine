# Source-mode configuration for the independent login portal.
AUTH_DEMO_PLAYER_SERVICE_URL=http://127.0.0.1:3213

# Must equal BOX_PLAYER_AUTH_API_KEY on Player Service. Keep it server-side.
AUTH_DEMO_API_KEY=replace-with-the-same-random-key-at-least-16-characters

AUTH_DEMO_HOST=127.0.0.1
AUTH_DEMO_PORT=3214
AUTH_DEMO_PUBLIC_URL=http://127.0.0.1:3214
AUTH_DEMO_CREATOR_URL=http://127.0.0.1:3002
AUTH_DEMO_PLAY_URL=http://127.0.0.1:3000
AUTH_DEMO_REQUEST_TIMEOUT_MS=10000

# Enable only when this portal is behind a trusted reverse proxy.
AUTH_DEMO_TRUST_PROXY=false
