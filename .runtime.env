# 镜像版本。发布新版本时统一修改这里即可。
BOX_IMAGE_TAG=0.1.1

# 游玩端公开端口；创作端只绑定本机，两者可以同时启动。
BOX_PLAY_HOST_IP=127.0.0.1
BOX_PLAY_PORT=3121
BOX_PLAY_LIBRARY_DIR=./apps/local-engine/play-worlds
BOX_CREATOR_PORT=3002

# 公网反向代理后的完整访问地址，例如 https://game.example.com。
BOX_SERVER_PUBLIC_URL=

# 只有流量始终经过可信反向代理时才设为 true。
BOX_TRUST_PROXY=true

# 玩家会话安全限制。
BOX_SESSION_TTL_MS=60000
BOX_SESSION_RATE_LIMIT_PER_MINUTE=60

# 可选：开启游玩端服主管理。建议使用 openssl rand -hex 32 生成。
# 开启后还要将 BOX_PLAY_LIBRARY_READ_ONLY 改为 false，才能导入或删除地图。
BOX_PLAY_ADMIN_TOKEN=5761fc7095bbe0469b8b1cba5019e011592bf90298b776b985352396fc64c2ca
BOX_PLAY_LIBRARY_READ_ONLY=false

# 创作端默认只接受 localhost/127.0.0.1。需要增加本地域名时用逗号分隔。
BOX_CREATOR_ALLOWED_HOSTS=127.0.0.1

# VOXA 独立模型编辑器端口。创作端浏览器会访问这个地址。
BOX_VOXA_PORT=3001

# VOXA 单个本地文件上限，默认 256 MiB。
VOXA_MAX_BLOB_BYTES=268435456

# 默认导出给常见 x86_64 私服。ARM 服务器改成 linux/arm64 后重新构建和导出。
BOX_PLAY_PLATFORM=linux/arm64

BOX_LOCAL_PLAYER_LIMIT=8
# 单个地图脚本运行时的内存上限（MiB）。大型体素地图建议保持 512；
# 小型服务器可适当降低，但过低会导致 Array buffer allocation failed。
BOX_SCRIPT_MEMORY_MB=512
BOX_SCRIPT_HEAP_MB=512

# 正式部署建议生成固定随机值，例如：openssl rand -hex 32
PERMISSION_TOKEN_SECRET=d666b624bd74d6e4a7a08236968656c5ee1a3137e3f00dd8e1f4cd4ecaba6124

# 可选：由服主提供 PostgreSQL，持久化地图脚本的 storage 数据空间。
# 不配置时保持现有存储方式；数据库密码不要提交到 Git。
BOX_DATABASE_URL=postgresql://box_user_683e6fb269c64870:c0a294c7ef6374d99373e1f422d8fd8c6f9ddf7e8da2acfaf8778bf96027cc1e@managed-postgres:5432/box_db_1f9335bd7f57b6be
BOX_DATABASE_SCHEMA=box_engine
BOX_DATABASE_POOL_SIZE=10
BOX_DATABASE_SSL=false
BOX_DATABASE_SSL_REJECT_UNAUTHORIZED=true
BOX_DATA_STORAGE_LOCK_TIMEOUT_MS=10000

# 迁移旧 boxes 数据时填写原作品/地图 ID，例如 100010141。

# 多地图共用一个数据库时可加统一前缀；实际作品 ID 会自动追加用于隔离。
BOX_DATA_STORAGE_NAMESPACE_PREFIX=

# 可选：需要让 group storage 跨作品共享时填写稳定的分组标识。

# Redis：业务状态使用 DB 3，运行时缓存使用 DB 4。
REDIS_HOST=43.154.99.73
REDIS_PORT=6379
REDIS_PASSWORD=vifanlyrs
REDIS_DB=3
STORAGE_CACHE_REDIS_DB=4
STORAGE_CACHE_REDIS_TTL=240

# 可选：Docker Hub 较慢时替换基础镜像。
# BOX_DOCKER_NODE_IMAGE=node:22.17.0-bookworm-slim
## 云端工程迁移器：公开 BOX CDN 的内容 blob 地址。
BOX_MIGRATOR_PORT=4120
# 国内网络使用 DaoCloud 的 Docker Hub 代理；仅替换基础镜像来源，不改变 Node 镜像内容。
BOX_DOCKER_NODE_IMAGE=docker.m.daocloud.io/library/node:22.17.0-bookworm-slim


BOX_PLAYER_LOGIN_URL=http://127.0.0.1:3214

# Linux Web 管理端，仅绑定本机；通过 SSH 隧道访问。
BOX_SERVER_MANAGER_BIND_IP=127.0.0.1
BOX_SERVER_MANAGER_PORT=3130
BOX_SERVER_MANAGER_TOKEN=4ed4eafc69cd38ca58aa4898792db4f7cc28c252de5859ffde090986ef94d46c
BOX_SERVER_MANAGER_MEMORY_LIMIT=128m
BOX_SERVER_MANAGER_CPU_LIMIT=0.5
BOX_SERVER_MANAGER_HOST_ROOT=
BOX_LAN_IP=
BOX_LICENSE_INSTALL_SECRET=6bf48cee1c8c560dbeca73d714cf8bcf7b2b2a437c5e05800518a64480894794

# 认证 API 的服务端密钥，至少 16 位。可用 openssl rand -hex 32 生成。
# 只配置在 Player Service 和服主登录后端，禁止写入浏览器代码。
BOX_PLAYER_AUTH_API_KEY=a3a5f60c60f69ea48eba8d11a3f2bfc65ddfcb5f9fea18c068761e04ce16e21a
BOX_CREATOR_HOST=127.0.0.1
BOX_CREATOR_NETWORK_MODE=local
BOX_PLAYER_LOGIN_URL_OVERRIDE=http://127.0.0.1:3214
BOX_PLAY_NETWORK_MODE=local
BOX_PLAY_PUBLIC_HOST=127.0.0.1
BOX_DATABASE_MODE=managed
BOX_REDIS_MODE=external
BOX_PLAYER_SERVICE_PORT=3124
BOX_AUTH_PORTAL_PORT=3125
BOX_CREATOR_EDIT_MAX_RUNTIMES=6
BOX_CREATOR_PLAY_MAX_RUNTIMES=4
BOX_CREATOR_EDIT_PREWARM_RUNTIMES=0
BOX_PLAY_MAX_RUNTIMES=8
BOX_PLAY_PREWARM_RUNTIMES=0
BOX_TELEPORT_MAX_ROOMS=64
BOX_AUTO_BACKUP_INTERVAL_MINUTES=60
BOX_AUTO_BACKUP_RETENTION_COUNT=24
BOX_AUTO_BACKUP_RETENTION_DAYS=30
BOX_RUNTIME_IDLE_TIMEOUT_MS=900000
BOX_RUNTIME_START_TIMEOUT_MS=1800000
BOX_TELEPORT_ROOM_IDLE_TIMEOUT_MS=900000
BOX_PLAYER_SERVICE_MEMORY_LIMIT=1024m
BOX_AUTH_PORTAL_MEMORY_LIMIT=128m
BOX_CREATOR_MEMORY_LIMIT=6144m
BOX_PLAY_MEMORY_LIMIT=4096m
BOX_PLAYER_SERVICE_CPU_LIMIT=1
BOX_AUTH_PORTAL_CPU_LIMIT=0.5
BOX_CREATOR_CPU_LIMIT=4
BOX_PLAY_CPU_LIMIT=4
BOX_AUTO_BACKUP_ENABLED=false
BOX_PLAYER_REGISTRATION_ENABLED=true
BOX_DATABASE_HOST=managed-postgres
BOX_DATABASE_PORT=5432
BOX_DATABASE_NAME=box_db_1f9335bd7f57b6be
BOX_DATABASE_USER=box_user_683e6fb269c64870
BOX_DATABASE_PASSWORD=c0a294c7ef6374d99373e1f422d8fd8c6f9ddf7e8da2acfaf8778bf96027cc1e
BOX_MANAGED_POSTGRES_DATABASE=box_db_1f9335bd7f57b6be
BOX_MANAGED_POSTGRES_USER=box_user_683e6fb269c64870
BOX_MANAGED_POSTGRES_PASSWORD=c0a294c7ef6374d99373e1f422d8fd8c6f9ddf7e8da2acfaf8778bf96027cc1e
BOX_PLAY_PUBLIC_URL=http://127.0.0.1:3121
BOX_BIND_IP=127.0.0.1
BOX_CREATOR_PUBLIC_URL=http://127.0.0.1:3002
BOX_CREATOR_BIND_IP=127.0.0.1
BOX_VOXA_BIND_IP=127.0.0.1
BOX_AUTH_PORTAL_PUBLIC_URL=http://127.0.0.1:3125
BOX_LICENSE_DEVICE_FILE=./license/device-id
BOX_LICENSE_FILE=./license/box3-license.boxlic
BOX_PLAYER_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3121,http://127.0.0.1:3002,http://127.0.0.1:3125,http://127.0.0.1:3214
BOX_PLAYER_SERVICE_INTERNAL_URL=http://player-service:3213
BOX_PLAYER_SERVICE_PUBLIC_URL=http://127.0.0.1:3124
BOX_RESOURCE_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:3002
BOX_VOXA_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:3002
BOX_VOXA_PUBLIC_URL=http://127.0.0.1:3001
COMPOSE_PROFILES=desktop-postgres,player-service,auth-portal,creator,play,voxa,server-manager
