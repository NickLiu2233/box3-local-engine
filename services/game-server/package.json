  "main": "index.js",
  "scripts": {
    "build": "node -r @swc-node/register --max-old-space-size=4096 scripts/index.ts && npm run build_isolate && tsc",
    "build_isolate": "rollup --config scripts/script-server/rollup.config.mjs",
    "dev": "node scripts/dev-launch.js",
    "generate-terrain": "node -r ts-node/register --max-old-space-size=4096 scripts/terrain/generate-terrain.ts",
    "check:postgres-storage": "node -r @swc-node/register scripts/check-postgres-data-storage.ts",
    "check:local-storage": "node -r @swc-node/register scripts/check-local-data-storage.ts",
    "check:redis-runtime": "node -r @swc-node/register scripts/check-redis-runtime.ts",
    "prod": "node dist/src/launch.js --useProdBundle",
    "test": "node -r @swc-node/register scripts/regression-local-voxa-fallback.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.28",
    "@box-local/apis": "workspace:0.1.0",
    "@box-local/build-system": "workspace:0.3.1",
