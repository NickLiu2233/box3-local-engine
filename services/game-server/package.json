    "@rollup/plugin-typescript": "12.1.2",
    "@swc-node/register": "1.10.10",
    "@swc/core": "1.4.13",
    "@swc/types": "0.1.21",
    "@types/debug": "4.1.7",
    "@types/ip": "~1.1.0",
    "@types/node": "20.16.15",
    "@types/parse": "3.0.2",
    "@types/pg": "8.15.5",
