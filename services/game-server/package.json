    "@box-local/schema": "workspace:~0.4.3",
    "@box-local/script-api": "workspace:~0.3.0",
    "@box-local/utils": "workspace:*",
    "@box-local/vb-parser": "workspace:1.0.7",
    "@box-local/voxa-project": "workspace:1.3.5",
    "@openrouter/ai-sdk-provider": "~1.2.5",
    "agora-access-token": "2.0.4",
    "ai": "5.0.92",
    "axios": "1.7.0",
    "debug": "4.3.4",
    "dotenv": "16.0.1",
    "gl-matrix": "3.4.3",
    "ip": "~1.1.8",
    "isolated-vm": "5.0.4",
    "limiter": "2.1.0",
    "minimist": "1.2.0",
    "nanoid": "3.2.0",
    "pg": "8.16.3",
    "pino": "8.19.0",
    "pino-pretty": "11.0.0",
    "simplex-noise": "3.0.1",
