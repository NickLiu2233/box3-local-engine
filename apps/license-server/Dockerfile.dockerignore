**

!package.json
!rush.json

# Rush configuration and launchers.
!common/
common/**
!common/config/
common/config/**
!common/config/rush/
!common/config/rush/**
!common/scripts/
!common/scripts/**

# Rush must read every registered project manifest even for a filtered
# install. Only the license server and shared license package need source.
!apps/
apps/**
!apps/*/
apps/*/**
!apps/*/package.json
!apps/license-server/
!apps/license-server/**

!examples/
examples/**
!examples/*/
examples/*/**
!examples/*/package.json

!internals/
internals/**
!internals/*/
internals/*/**
!internals/*/package.json

!packages/
packages/**
!packages/*/
packages/*/**
!packages/*/package.json
!packages/license/
!packages/license/**

!services/
services/**
!services/*/
services/*/**
!services/*/package.json

!tools/
tools/**
!tools/*/
tools/*/**
!tools/*/package.json

# Local dependencies, build output, signing material and configuration are
# always recreated or mounted at runtime. Keep these rules last because the
# final matching Docker ignore rule wins.
**/node_modules/
**/.rush/
**/.next*/
**/dist/
**/target/
common/temp/
apps/license-server/.local/
apps/license-server/.env
apps/license-server/.env.*
!apps/license-server/.env.example
