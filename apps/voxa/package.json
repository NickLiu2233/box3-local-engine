  "main": "index.js",
  "scripts": {
    "build": "pnpm run build-i18n && next build",
    "build-i18n": "formatjs compile-folder --ast lang/src lang/build",
    "dev": "next dev -p 3001",
    "lint": "next lint",
    "start": "next start -p 3001",
    "ts-watch": "tsc --noEmit --incremental --watch",
    "update-i18n": "formatjs extract 'src/**/*.ts*' --ignore='**.*.d.ts' --out-file lang/src/en.json && node lang/update-locales.mjs"
  },
