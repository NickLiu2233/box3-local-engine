{
  "name": "@box/player-launcher",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone BOX3 player launcher for locally prepared online maps",
  "author": "深圳奇梦岛科技有限公司",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port 1421",
    "build": "vite build",
    "check": "npm run typecheck && npm run build && npm test && npm run build:electron-main",
    "test": "tsx --test electron/services/*.test.ts tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "npm run bundle:electron",
    "dev:electron": "npm run build:electron-main && electron . --dev",
    "build:electron-main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:vite",
    "build:electron": "npm run typecheck && npm run build && npm run build:electron-main",
    "bundle:electron": "npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "com.box.player.launcher",
    "productName": "BOX3 Player Launcher",
    "asar": true,
    "electronLanguages": ["en-US", "zh-CN"],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icons/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources/icons",
      "output": "release-electron"
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "resources/icons/icon.icns",
      "extendInfo": {
        "CFBundleDisplayName": "BOX3 Player Launcher",
        "CFBundleName": "BOX3 Player Launcher"
      },
      "target": ["dmg"]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "category": "Game",
      "icon": "resources/icons/icon.png",
      "target": ["AppImage"]
    }
  },
  "dependencies": {
    "@box/apis": "workspace:0.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "^7.1.0"
  }
}
