{
  "name": "@box-local/local-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first local runner for the Box engine",
  "scripts": {
    "build:creator": "node src/build.js --creator",
    "build:play": "node src/build.js --play",
    "prepare-assets": "node src/prepare-assets.js",
    "sync-default-avatar": "node src/sync-default-avatar.js",
    "dev": "node src/launcher.js --creator",
    "start:creator": "node src/launcher.js --production --creator",
    "start:play": "node src/launcher.js --production --play"
  },
  "dependencies": {
    "@box-local/build-system": "workspace:0.3.1",
    "@box-local/content-server": "workspace:*"
  }
}
