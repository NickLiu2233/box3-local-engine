{
  "name": "@box/migrator",
  "version": "0.3.0",
  "private": true,
  "description": "Cloud project to Local Engine project migration tool",
  "scripts": {
    "dev": "next dev -p 3212",
    "build": "next build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --cache --cache-location .next/cache/eslint/.eslintcache",
    "test": "node scripts/regression-preview-image.cjs && node scripts/regression-running-job-retention.cjs && node scripts/regression-persisted-migration-job.cjs",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 3212"
  },
  "dependencies": {
    "@box/mudb": "workspace:1.0.4",
    "@box/schema": "workspace:~0.4.3",
    "@box/vb-parser": "workspace:1.0.7",
    "@box/voxa-project": "workspace:1.3.5",
    "next": "15.5.24",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@types/node": "20.16.15",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "9.1.0",
    "typescript": "5.6.3"
  }
}
