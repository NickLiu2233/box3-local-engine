{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOX3 Engine",
  "version": "0.1.1",
  "identifier": "com.box.engine.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BOX3 Engine",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-src http: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["payload"],
    "icon": ["icons/icon.ico", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "Install and manage BOX3 Engine",
    "longDescription": "A native graphical installer and operations console for BOX3 Engine.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
