# Runtime environment files can contain deployment secrets. Keep only the
# documented defaults and examples in source control.
.env.*
!.env.docker.example
!**/.env.example
!**/.env.*.example

# 本机创作数据只能通过工程导入/导出流转，不能随代码提交或发行。
# 已跟踪的默认资源不受此规则影响；新增素材会被忽略。
apps/local-engine/data/*
!apps/local-engine/data/blobs/
apps/local-engine/data/blobs/*
!apps/local-engine/data/blobs/.gitkeep
apps/local-engine/projects/
apps/local-engine/dist/
apps/local-engine/backups/
apps/local-engine/play-worlds/*
!apps/local-engine/play-worlds/.gitkeep
apps/local-engine/.build-lock/

# VOXA model projects and uploaded blobs belong to the local creator.
apps/voxa/data/
apps/migrator/cache/

# Native deployment manager build output is reproducible and must not enter source releases.
apps/deployment-manager/dist/
apps/deployment-manager/src-tauri/gen/
apps/deployment-manager/src-tauri/target/
