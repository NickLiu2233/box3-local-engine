node_modules/
.pnpm-store/
# Rush generates project links and its temporary PNPM workspace locally.
**/.rush/
common/temp/
common/deploy/
common/autoinstallers/*/node_modules/
common/autoinstallers/*/.rush/
.next/
apps/game/.next-*/
apps/game/.tsconfig.dev-*.json
# The Player game client bundles are regenerated by build-player:*; keep the
# TypeScript sources and generated resource-cache Service Worker only.
apps/game/dist/
apps/game/public/dist/
# Player admin bundles and Umi's generated runtime source are rebuilt during
# the player-service image build; keep source changes only.
apps/game/public/player-admin/
apps/player-admin/src/.umi/
apps/player-admin/src/.umi-production/
services/game-server/dist/
coverage/
apps/game/html-report/
*.log
.DS_Store
apps/license-server/.local/
*.tsbuildinfo
.env.local
.env.*.local
.env
.runtime.env
# Runtime environment files can contain deployment secrets. Keep only the
# documented defaults and examples in source control.
.env.*
!.env.docker.example
!**/.env.example
!**/.env.*.example

# The launcher generates runtime configuration and license state locally.
# Keep the directory placeholder, never machine-bound credentials or IDs.
/license/*
!/license/.gitkeep

# Local .NET launcher outputs are reproducible build artifacts.
/tools/windows-launcher/bin/
/tools/windows-launcher/obj/

# 本机创作数据只能通过工程导入/导出流转，不能随代码提交或发行。
# 已跟踪的默认资源不受此规则影响；新增素材会被忽略。
apps/local-engine/data/*
!apps/local-engine/data/blobs/
apps/local-engine/data/blobs/*
!apps/local-engine/data/blobs/.gitkeep
apps/local-engine/projects/
# Ephemeral edit/play runtime blobs and build caches. They are rebuilt from
# local map data and must never be versioned or shipped as source artifacts.
apps/local-engine/runtime-cache/
apps/local-engine/dist/
apps/local-engine/backups/
apps/local-engine/play-worlds/*
!apps/local-engine/play-worlds/.gitkeep
apps/local-engine/.build-lock/

# VOXA model projects and uploaded blobs belong to the local creator.
apps/voxa/data/
apps/migrator/cache/

# Native deployment manager build output is reproducible and must not enter source releases.
apps/deployment-manager/dist/
apps/deployment-manager/src-tauri/gen/
apps/deployment-manager/src-tauri/target/

# Player launcher Electron build output.
apps/player-launcher/dist/
apps/player-launcher/dist-electron/
apps/player-launcher/release-electron/
apps/player-launcher/release-electron-ts/
apps/player-launcher/release-electron-next/

# Rust headless server manager build output.
apps/server-manager-rust/target/

apps/manager-core/target/
