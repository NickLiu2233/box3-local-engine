{
  "name": "box-local-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone local-first voxel engine developer preview",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.17.x"
  },
  "scripts": {
    "rush": "node common/scripts/install-run-rush.js",
    "install:all": "node common/scripts/install-run-rush.js install",
    "update:all": "node common/scripts/install-run-rush.js update",
    "check:versions": "node common/scripts/install-run-rush.js check",
    "dev": "node common/scripts/install-run-rush.js dev",
    "dev:infra": "node common/scripts/install-run-rush.js dev --infra",
    "dev:creator": "node common/scripts/install-run-rush.js dev-creator",
    "dev:creator:infra": "node common/scripts/install-run-rush.js dev-creator --infra",
    "build": "node common/scripts/install-run-rush.js build",
    "format": "node common/scripts/install-run-rush.js format",
    "format:check": "node common/scripts/install-run-rush.js format-check",
    "lint": "node common/scripts/install-run-rush.js lint",
    "typecheck": "node common/scripts/install-run-rush.js typecheck",
    "test": "node common/scripts/install-run-rush.js test",
    "check": "node common/scripts/install-run-rush.js integration-check",
    "verify": "node common/scripts/install-run-rush.js verify",
    "version:check": "node common/scripts/install-run-rush.js version-check",
    "package:images": "node common/scripts/install-run-rush.js package-images",
    "package:images:amd64": "node common/scripts/install-run-rush.js package-images --architecture amd64",
    "package:images:arm64": "node common/scripts/install-run-rush.js package-images --architecture arm64",
    "export:images": "node common/scripts/install-run-rush.js export-images",
    "package:desktop": "node common/scripts/install-run-rush.js package-desktop",
    "package:desktop:windows-amd64": "node common/scripts/install-run-rush.js package-desktop --target windows-amd64",
    "package:desktop:windows-arm64": "node common/scripts/install-run-rush.js package-desktop --target windows-arm64",
    "package:desktop:macos-amd64": "node common/scripts/install-run-rush.js package-desktop --target macos-amd64",
    "package:desktop:macos-arm64": "node common/scripts/install-run-rush.js package-desktop --target macos-arm64",
    "package:desktop:linux-amd64": "node common/scripts/install-run-rush.js package-desktop --target linux-amd64",
    "package:desktop:linux-arm64": "node common/scripts/install-run-rush.js package-desktop --target linux-arm64",
    "package:web": "node common/scripts/install-run-rush.js package-web",
    "package:web:amd64": "node common/scripts/install-run-rush.js package-web --architecture amd64",
    "package:web:arm64": "node common/scripts/install-run-rush.js package-web --architecture arm64"
  }
}
