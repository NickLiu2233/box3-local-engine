{
  "name": "box-local-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone local-first voxel engine developer preview",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "creator": "node apps/local-engine/src/deploy.js creator",
    "creator:up": "docker compose --profile creator up -d --no-build creator",
    "player-service": "node apps/local-engine/src/deploy.js player-service",
    "player-service:up": "node apps/local-engine/src/deploy.js player-service-up",
    "voxa": "node apps/local-engine/src/deploy.js voxa",
    "voxa:up": "node apps/local-engine/src/deploy.js voxa-up",
    "voxa:image": "docker compose --profile voxa build voxa",
    "voxa:dev": "pnpm --filter @box-local/voxa dev",
    "migrator": "docker compose --profile migrator up -d --build migrator",
    "migrator:up": "docker compose --profile migrator up -d --no-build migrator",
    "migrator:dev": "pnpm --filter @box-local/migrator dev",
    "infra": "docker compose --profile infra up -d postgres redis",
    "infra:stop": "docker compose --profile infra stop postgres redis",
    "play": "node apps/local-engine/src/deploy.js play",
    "play:up": "docker compose --profile play up -d --no-build play",
    "stop": "node apps/local-engine/src/deploy.js stop",
    "dev": "node apps/local-engine/src/launcher.js --creator",
    "build:creator": "node apps/local-engine/src/build.js --creator",
    "build:play": "node apps/local-engine/src/build.js --play",
    "build:voxa": "pnpm --filter @box-local/voxa build",
    "start:creator": "node apps/local-engine/src/launcher.js --production --creator",
    "start:play": "node apps/local-engine/src/launcher.js --production --play",
    "prepare:assets": "pnpm --dir apps/local-engine run prepare-assets",
    "sync:avatar": "pnpm --dir apps/local-engine run sync-default-avatar",
    "project:list": "node apps/local-engine/src/project-manager.js list",
    "project:create": "node apps/local-engine/src/project-manager.js create",
    "project:publish": "node apps/local-engine/src/project-manager.js publish",
    "project:package": "node apps/local-engine/src/project-manager.js package",
    "check": "node scripts/check-standalone.js && node scripts/check-play-version-refresh.js",
    "check:voxa-map-link": "pnpm --filter @box-local/game-server exec node -r @swc-node/register ../../scripts/check-local-voxa-map-link.ts",
    "check:voxa-extra-project": "pnpm --filter @box-local/game-server exec node -r @swc-node/register ../../scripts/check-local-voxa-extra-project.ts",
    "check:voxa-render": "pnpm --filter @box-local/game-server exec node -r @swc-node/register ../../scripts/check-local-voxa-render.ts",
    "check:edit-session": "node scripts/check-edit-session.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "isolated-vm",
      "sharp"
    ]
  }
}
