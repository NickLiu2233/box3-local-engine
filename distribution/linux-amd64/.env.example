# BOX Local Engine Linux AMD64 offline package
# Copy this file to .env before first startup. Do not share the final .env.
COMPOSE_PROFILES=player-service,auth-portal,creator,play,voxa
BOX_IMAGE_TAG=0.1.0-linux-amd64
BOX_PLAY_PLATFORM=linux/amd64

# 127.0.0.1 only allows this server to access the services. Use 0.0.0.0
# behind a firewall/reverse proxy, then set the public URLs to your domain.
BOX_BIND_IP=127.0.0.1
BOX_PLAY_PORT=3000
BOX_VOXA_PORT=3001
BOX_CREATOR_PORT=3002
BOX_PLAYER_SERVICE_PORT=3213
BOX_AUTH_PORTAL_PORT=3214
BOX_PLAY_PUBLIC_URL=http://127.0.0.1:3000
BOX_VOXA_PUBLIC_URL=http://127.0.0.1:3001
BOX_CREATOR_PUBLIC_URL=http://127.0.0.1:3002
BOX_PLAYER_SERVICE_PUBLIC_URL=http://127.0.0.1:3213
BOX_AUTH_PORTAL_PUBLIC_URL=http://127.0.0.1:3214
BOX_PLAYER_LOGIN_URL=http://127.0.0.1:3214
BOX_PLAYER_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3002,http://127.0.0.1:3214

# install.sh replaces these placeholders with random values when possible.
PERMISSION_TOKEN_SECRET=CHANGE_ME_PERMISSION_TOKEN_SECRET
BOX_PLAYER_AUTH_API_KEY=CHANGE_ME_PLAYER_AUTH_API_KEY
BOX_PLAY_ADMIN_TOKEN=CHANGE_ME_PLAY_ADMIN_TOKEN
BOX_PLAY_LIBRARY_READ_ONLY=false
BOX_TRUST_PROXY=false

# PostgreSQL is optional. Leave BOX_DATABASE_URL empty to disable player
# management and the getDataStorage/getGroupStorage APIs.
BOX_DATABASE_URL=
BOX_DATABASE_SCHEMA=box_engine
BOX_IDENTITY_DATABASE_SCHEMA=box_identity
BOX_DATABASE_POOL_SIZE=4
BOX_DATABASE_SSL=false
BOX_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Redis is optional. Leave REDIS_HOST empty to disable Redis caching.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
STORAGE_CACHE_REDIS_DB=1
STORAGE_CACHE_REDIS_TTL=240

# Runtime capacity and resource limits.
BOX_PLAY_MAX_RUNTIMES=8
BOX_CREATOR_EDIT_MAX_RUNTIMES=6
BOX_CREATOR_PLAY_MAX_RUNTIMES=4
BOX_RUNTIME_IDLE_TIMEOUT_MS=900000
BOX_SCRIPT_HEAP_MB=512
BOX_SCRIPT_MEMORY_MB=512
BOX_CREATOR_MEMORY_LIMIT=6g
BOX_CREATOR_CPU_LIMIT=4.0
BOX_PLAY_MEMORY_LIMIT=4g
BOX_PLAY_CPU_LIMIT=4.0
