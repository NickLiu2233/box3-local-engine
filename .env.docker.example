# 镜像版本。发布新版本时统一修改这里即可。
BOX_IMAGE_TAG=0.1.0

# 游玩端端口。默认只允许本机访问；需要直接对公网监听时，把 HOST_IP 改为 0.0.0.0。
BOX_PLAY_HOST_IP=127.0.0.1
BOX_PLAY_PORT=3000

# 创作端只应部署在创作者电脑或可信内网，Compose 会强制绑定 127.0.0.1。
BOX_CREATOR_PORT=3002

# VOXA 独立模型编辑器端口。创作端浏览器会访问这个地址。
BOX_VOXA_PORT=3001

# 云端工程迁移器。该服务与创作端、游玩端和 VOXA 使用不同镜像与端口。
BOX_MIGRATOR_PORT=3212
# 生产环境引擎后端；测试时可改为 https://staging-code-api-pc.dao3.fun。
BOX_MIGRATOR_ENGINE_API_URL=https://code-api-pc.dao3.fun
# boxes 调用引擎后端使用的 request-header-fixed-key。不要提交真实值。
BOX_MIGRATOR_ENGINE_API_KEY=
# 某些网关如额外要求 Authorization，可在这里配置完整值。
BOX_MIGRATOR_ENGINE_AUTHORIZATION=
BOX_MIGRATOR_ENGINE_API_TIMEOUT_MS=15000
# 推荐：与 boxes 的 GoIPFSStore 一致，自动请求 /block/get?arg=<hash>。
# BOX_MIGRATOR_CONTENT_API_URL=https://content-api.example.com
# 必填：支持 {hash} 占位符，或填写 CDN 基址（自动拼接 /block/<hash>）。
# 未配置 CONTENT_API_URL 时，至少需要配置下面的静态内容地址。
# BOX_MIGRATOR_CONTENT_URL=https://cdn.example.com/block/{hash}
# 工程内 UI 图片和脚本等直接依赖的 OSS 资源基址。
BOX_MIGRATOR_OSS_URL=https://assets.box3.fun
# 私有内容服务可选的 Authorization 请求头；只在迁移器服务端使用。
BOX_MIGRATOR_AUTHORIZATION=
BOX_MIGRATOR_MAX_BLOBS=20000
BOX_MIGRATOR_MAX_TOTAL_BYTES=1073741824
BOX_MIGRATOR_MAX_BLOB_BYTES=67108864
BOX_MIGRATOR_CONCURRENCY=32
BOX_MIGRATOR_SCAN_CONCURRENCY=20000
BOX_MIGRATOR_REQUEST_TIMEOUT_MS=8000
BOX_MIGRATOR_MODEL_MIGRATION_POLLS=60

# VOXA 单个本地文件上限，默认 256 MiB。
VOXA_MAX_BLOB_BYTES=268435456

# 默认导出给常见 x86_64 私服。ARM 服务器改成 linux/arm64 后重新构建和导出。
BOX_PLAY_PLATFORM=linux/amd64

BOX_WORLD_NAME=我的 BOX 世界
BOX_LOCAL_PLAYER_LIMIT=8

# 可选：开启游玩端网页服主管理。正式环境请使用至少 16 位随机值。
# 开启后地图目录必须允许写入，服主才可以导入、导出和删除 .boxplay。
BOX_PLAY_ADMIN_TOKEN=
BOX_PLAY_LIBRARY_READ_ONLY=true

# 可选：自定义宿主机地图库目录。留空时使用仓库内的 play-worlds。
BOX_PLAY_LIBRARY_DIR=

# 正式部署建议生成固定随机值，例如：openssl rand -hex 32
PERMISSION_TOKEN_SECRET=

# 使用 HTTPS 反向代理时填写玩家实际访问地址。
BOX_SERVER_PUBLIC_URL=
# 只有可信反向代理会覆盖并清洗转发头时才设为 true。
BOX_TRUST_PROXY=false

BOX_SESSION_TTL_MS=60000
BOX_SESSION_RATE_LIMIT_PER_MINUTE=60

# 可选：由服主提供 PostgreSQL，持久化地图脚本的 storage 数据空间。
# 不配置时保持现有存储方式；数据库密码不要提交到 Git。
BOX_DATA_STORAGE_DRIVER=legacy
BOX_DATABASE_URL=
BOX_DATABASE_SCHEMA=box_engine
BOX_DATABASE_POOL_SIZE=10
BOX_DATABASE_SSL=false
BOX_DATABASE_SSL_REJECT_UNAUTHORIZED=true
BOX_DATA_STORAGE_LOCK_TIMEOUT_MS=10000

# 多地图共用一个数据库时可加统一前缀；实际作品 ID 会自动追加用于隔离。
BOX_DATA_STORAGE_NAMESPACE_PREFIX=

# 可选：需要让 group storage 跨作品共享时填写稳定的分组标识。
BOX_GROUP_STORAGE_NAMESPACE=

# 可选：由本仓库的 `pnpm infra` 启动 PostgreSQL 16 和 Redis 7。
# 两个端口都只绑定宿主机 127.0.0.1；正式使用前仍应修改默认密码。
BOX_POSTGRES_IMAGE=postgres:16-alpine
BOX_POSTGRES_HOST_PORT=5432
BOX_POSTGRES_DB=box
BOX_POSTGRES_USER=box
BOX_POSTGRES_PASSWORD=

BOX_REDIS_IMAGE=redis:7-alpine
BOX_REDIS_HOST_PORT=6379
BOX_REDIS_PASSWORD=

# 使用上面的内置 PostgreSQL 时，取消下面两行注释，并保持密码一致。
# BOX_DATA_STORAGE_DRIVER=postgres
# BOX_DATABASE_URL=postgresql://box:local-box-change-me@postgres:5432/box

# Redis 目前仅做运行时配置兼容和后续 adapter 预留，尚未承载 session、限流或 storage cache。
# 真正接入前请保持 REDIS_HOST 为空；不要因为启动了 Redis 就认为数据会自动写入其中。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
STORAGE_CACHE_REDIS_DB=1
STORAGE_CACHE_REDIS_TTL=300

# 可选：Docker Hub 较慢时替换基础镜像。
# BOX_DOCKER_NODE_IMAGE=node:22.17.0-bookworm-slim
