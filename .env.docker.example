# 对外发布的服务端地址。局域网部署请替换成服务器电脑的 IP。
BOX_SERVER_PUBLIC_URL=http://192.168.1.20:9966

# 玩家客户端默认连接的地址。留空时可在 /connect 页面手动输入。
BOX_REMOTE_SERVER_URL=http://192.168.1.20:9966

BOX_SERVER_NAME=我的 BOX 世界
BOX_SERVER_CONTENT_ID=0
BOX_LOCAL_PLAYER_LIMIT=8

# Docker 主机暴露的端口。
BOX_SERVER_PUBLISHED_PORT=9966
BOX_CLIENT_PUBLISHED_PORT=3000

# 可选：Docker Hub 较慢时可以替换为公司或云厂商提供的 Node 22 Debian 镜像。
# 镜像中必须包含 Node.js 22、Corepack 和 apt-get。
# BOX_DOCKER_NODE_IMAGE=node:22.17.0-bookworm-slim
