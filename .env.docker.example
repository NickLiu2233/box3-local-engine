# 镜像版本。发布新版本时统一修改这里即可。
BOX_IMAGE_TAG=0.1.0
# CI/正式构建建议填写版本、Git commit、RFC 3339 构建时间和源码地址；
# 它们会写入镜像 OCI 标签和分发包 BUILD-INFO.json。
BOX_BUILD_VERSION=0.1.0
BOX_BUILD_COMMIT=unknown
BOX_BUILD_DATE=unknown
BOX_BUILD_SOURCE=local

# 游玩端端口。默认只允许本机访问；需要直接对公网监听时，把 HOST_IP 改为 0.0.0.0。
BOX_PLAY_HOST_IP=127.0.0.1
BOX_PLAY_PORT=3000

# 创作端只应部署在创作者电脑或可信内网，Compose 会强制绑定 127.0.0.1。
BOX_CREATOR_PORT=3002
# 反向代理使用非 localhost Host 访问创作端时，填写逗号分隔的可信主机名。
BOX_CREATOR_ALLOWED_HOSTS=

# 独立玩家身份与管理服务。Creator 和 Play 都通过这个地址读取同一份玩家资料。
BOX_PLAYER_SERVICE_PORT=3213
BOX_PLAYER_SERVICE_PUBLIC_URL=http://127.0.0.1:3213
BOX_CREATOR_PUBLIC_URL=http://127.0.0.1:3002
BOX_PLAY_PUBLIC_URL=http://127.0.0.1:3000
# 可选：服主自行部署的登录页面。配置后附带 source、returnUrl 跳转；留空显示“未开启登录”。
BOX_PLAYER_LOGIN_URL=
# 认证 API 的服务端密钥，至少 16 位。可用 openssl rand -hex 32 生成。
# 只配置在 Player Service 和服主登录后端，禁止写入浏览器代码。
BOX_PLAYER_AUTH_API_KEY=
# 可选附加限制：允许的登录服务 Origin，多个地址用英文逗号分隔，不支持 *。
BOX_PLAYER_AUTH_ALLOWED_ORIGINS=

# 可选的独立登录/注册门户镜像。它只用于给服主快速部署和测试，账号仍由 Player Service 管理。
# 启用时把上面的 BOX_PLAYER_LOGIN_URL 设置为与 BOX_AUTH_PORTAL_PUBLIC_URL 相同的浏览器地址。
BOX_AUTH_PORTAL_HOST_IP=127.0.0.1
BOX_AUTH_PORTAL_PORT=3214
BOX_AUTH_PORTAL_PUBLIC_URL=http://127.0.0.1:3214
BOX_AUTH_PORTAL_REQUEST_TIMEOUT_MS=10000
BOX_AUTH_PORTAL_MEMORY_LIMIT=128m
BOX_AUTH_PORTAL_CPU_LIMIT=0.5
BOX_AUTH_PORTAL_PIDS_LIMIT=64

# VOXA 独立模型编辑器端口。创作端浏览器会访问这个地址。
BOX_VOXA_PORT=3001

# 云端工程迁移器。该服务与创作端、游玩端和 VOXA 使用不同镜像与端口。
BOX_MIGRATOR_PORT=3212
# 生产环境引擎后端；测试时可改为 https://staging-code-api-pc.dao3.fun。
BOX_MIGRATOR_ENGINE_API_URL=https://code-api-pc.dao3.fun
# boxes 调用引擎后端使用的 request-header-fixed-key。不要提交真实值。
BOX_MIGRATOR_ENGINE_API_KEY=
# 某些网关如额外要求 Authorization，可在这里配置完整值。
BOX_MIGRATOR_ENGINE_AUTHORIZATION=
BOX_MIGRATOR_ENGINE_API_TIMEOUT_MS=15000
# 推荐：与 boxes 的 GoIPFSStore 一致，自动请求 /block/get?arg=<hash>。
# BOX_MIGRATOR_CONTENT_API_URL=https://content-api.example.com
# 必填：支持 {hash} 占位符，或填写 CDN 基址（自动拼接 /block/<hash>）。
# 未配置 CONTENT_API_URL 时，至少需要配置下面的静态内容地址。
# BOX_MIGRATOR_CONTENT_URL=https://cdn.example.com/block/{hash}
# 工程内 UI 图片和脚本等直接依赖的 OSS 资源基址。
BOX_MIGRATOR_OSS_URL=https://assets.box3.fun
# 私有内容服务可选的 Authorization 请求头；只在迁移器服务端使用。
BOX_MIGRATOR_AUTHORIZATION=
BOX_MIGRATOR_MAX_BLOBS=20000
BOX_MIGRATOR_MAX_TOTAL_BYTES=1073741824
BOX_MIGRATOR_MAX_BLOB_BYTES=67108864
BOX_MIGRATOR_CONCURRENCY=32
BOX_MIGRATOR_SCAN_CONCURRENCY=512
BOX_MIGRATOR_REQUEST_TIMEOUT_MS=8000
# 完成或失败后保留迁移结果/状态的时间，运行中的任务不受此限制。
BOX_MIGRATOR_RESULT_RETENTION_MS=3600000
BOX_MIGRATOR_MODEL_MIGRATION_POLLS=60

# VOXA 单个本地文件上限，默认 256 MiB。
VOXA_MAX_BLOB_BYTES=268435456

# 默认导出给常见 x86_64 私服。ARM 服务器改成 linux/arm64 后重新构建和导出。
BOX_PLAY_PLATFORM=linux/amd64

BOX_LOCAL_PLAYER_LIMIT=8

# 可选：开启游玩端网页服主管理。正式环境请使用至少 16 位随机值。
# 开启后地图目录必须允许写入，服主才可以导入、导出和删除 .boxplay。
BOX_PLAY_ADMIN_TOKEN=
BOX_PLAY_LIBRARY_READ_ONLY=true

# 可选：自定义宿主机地图库目录。留空时使用仓库内的 play-worlds。
BOX_PLAY_LIBRARY_DIR=

# 正式部署建议生成固定随机值，例如：openssl rand -hex 32
PERMISSION_TOKEN_SECRET=

# 使用 HTTPS 反向代理时填写玩家实际访问地址。
BOX_SERVER_PUBLIC_URL=
# 只有可信反向代理会覆盖并清洗转发头时才设为 true。
BOX_TRUST_PROXY=false

BOX_SESSION_TTL_MS=60000
# Player Service 交给地图运行时的内部身份断言有效期。大型地图首次预烘焙
# 可能超过一分钟；该令牌仅用于 Creator/Play 到游戏运行时的内部传递。
BOX_RUNTIME_IDENTITY_TTL_MS=300000
# 单个地图脚本运行时的内存上限（MiB）。512x256x512 地图仅体素镜像约占 128 MiB，
# 还需要为脚本、同步状态和运行时预留空间，因此默认 512。修改后需重新创建 Creator 和 Play 容器。
BOX_SCRIPT_HEAP_MB=512
BOX_SCRIPT_MEMORY_MB=512
# 玩家后台执行强制下线后，运行时获取下线事件的间隔（毫秒）
BOX_PLAYER_REVOCATION_POLL_MS=1000
BOX_SESSION_RATE_LIMIT_PER_MINUTE=60
# 大型导入作品首次预烘焙可能超过 20 秒；本地会话创建最长等待时间。
BOX_CREATE_SESSION_TIMEOUT_MS=120000

# 子运行时容量。达到上限时优先回收最久未使用且无连接的运行时；
# 空闲超过 15 分钟（900000ms）也会自动回收。
BOX_CREATOR_EDIT_MAX_RUNTIMES=6
BOX_CREATOR_PLAY_MAX_RUNTIMES=4
BOX_PLAY_MAX_RUNTIMES=8
# 后台预热数量不能超过对应运行时上限。设为 0 可关闭；默认只预热最近工程/主地图。
BOX_CREATOR_EDIT_PREWARM_RUNTIMES=6
# Creator 预览运行时会实际执行地图脚本，默认不在无人访问时启动；需要时可主动设置数量。
BOX_CREATOR_PLAY_PREWARM_RUNTIMES=0
BOX_PLAY_PREWARM_RUNTIMES=8
BOX_RUNTIME_IDLE_TIMEOUT_MS=900000
# 大型导入地图迁移和预烘焙的最长启动时间（毫秒）。超出前不会杀死仍在工作的运行时。
BOX_RUNTIME_START_TIMEOUT_MS=1800000
# 主图/副图共享资源状态的文件锁。通常无需修改：等待超时默认 30 秒，
# 无法确认所有者的旧锁超过 5 分钟后可回收；已确认崩溃的本机进程锁会立即回收。
BOX_GROUP_STATE_LOCK_TIMEOUT_MS=30000
BOX_GROUP_STATE_LOCK_STALE_MS=300000
# 地图组传送：私有房间数量上限与无人连接后的回收时间
BOX_TELEPORT_MAX_ROOMS=64
BOX_TELEPORT_ROOM_IDLE_TIMEOUT_MS=900000

# 容器硬资源限制。Compose 接受 512m、1g 等内存格式和小数 CPU。
BOX_PLAYER_SERVICE_MEMORY_LIMIT=1g
BOX_PLAYER_SERVICE_CPU_LIMIT=1.0
BOX_PLAYER_SERVICE_PIDS_LIMIT=256
BOX_CREATOR_MEMORY_LIMIT=6g
BOX_CREATOR_CPU_LIMIT=4.0
BOX_CREATOR_PIDS_LIMIT=1024
BOX_PLAY_MEMORY_LIMIT=4g
BOX_PLAY_CPU_LIMIT=4.0
BOX_PLAY_PIDS_LIMIT=1024

# 可选：为所有可编辑工程定时生成可直接导入的 .boxproject 备份。
# 默认关闭；开启后会在启动 15 秒后执行一次，此后按间隔执行。
BOX_AUTO_BACKUP_ENABLED=false
BOX_AUTO_BACKUP_INTERVAL_MINUTES=60
BOX_AUTO_BACKUP_RETENTION_COUNT=24
BOX_AUTO_BACKUP_RETENTION_DAYS=30
# Docker 部署保持下面路径不变；源码运行时留空会使用 apps/local-engine/backups。
BOX_PROJECT_BACKUP_PATH=/app/apps/local-engine/backups

# 默认使用完全离线的本地持久化 storage；填写 PostgreSQL 连接串后自动切换。
BOX_DATABASE_URL=
BOX_DATABASE_SCHEMA=box_engine
# 玩家身份镜像使用独立 schema，不与地图 getDataStorage 表混合。
BOX_IDENTITY_DATABASE_SCHEMA=box_identity
# 关闭后已有账号仍可登录，但新玩家不能自行注册；系统不提供游客模式。
BOX_PLAYER_REGISTRATION_ENABLED=true
# 登录仅统计失败次数；注册无论成功或校验失败都计入同一来源 IP 的窗口。
BOX_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
BOX_LOGIN_RATE_LIMIT_WINDOW_MS=300000
BOX_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
BOX_REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
# Creator、Play、Player Service 使用不同子域名时填写共同父域，例如 .example.com。
# 本机 127.0.0.1 不要配置。
BOX_PLAYER_COOKIE_DOMAIN=
BOX_DATABASE_POOL_SIZE=10
BOX_DATABASE_SSL=false
BOX_DATABASE_SSL_REJECT_UNAUTHORIZED=true
BOX_DATA_STORAGE_LOCK_TIMEOUT_MS=10000
# 可选部署前缀；地图与地图组命名空间始终由不可变 UUID 自动生成，不能手工覆盖。
BOX_DATA_STORAGE_NAMESPACE_PREFIX=

# 可选：由本仓库的 `pnpm infra` 启动 PostgreSQL 16 和 Redis 7。
# 两个端口都只绑定宿主机 127.0.0.1；正式使用前仍应修改默认密码。
BOX_POSTGRES_IMAGE=postgres:16-alpine
BOX_POSTGRES_HOST_PORT=5432
BOX_POSTGRES_DB=box
BOX_POSTGRES_USER=box
BOX_POSTGRES_PASSWORD=

BOX_REDIS_IMAGE=redis:7-alpine
BOX_REDIS_HOST_PORT=6379
BOX_REDIS_PASSWORD=

# 使用上面的内置 PostgreSQL 时，取消下面一行注释，并保持密码一致。
# BOX_DATABASE_URL=postgresql://box:local-box-change-me@postgres:5432/box

# 可选 Redis：业务 DB 承载跨实例 Session/限流，缓存 DB 承载预烘焙构建缓存。
# 留空会自动使用内存和本地文件回退，不影响单机启动。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
STORAGE_CACHE_REDIS_DB=1
STORAGE_CACHE_REDIS_TTL=240

# 默认使用中国大陆可访问的 Docker Hub 镜像代理。只替换来源，版本保持一致。
# 如部署环境可直接访问 Docker Hub，可改为 node:22.17.0-bookworm-slim。
BOX_DOCKER_NODE_IMAGE=docker.m.daocloud.io/library/node:22.17.0-bookworm-slim
